.page { padding: 20rpx 12rpx 60rpx; }
.info { display: flex; justify-content: space-between; font-size: 24rpx; color: #8a7560; margin-bottom: 16rpx; }
.toolbar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.board-wrap { display: flex; justify-content: center; }
.board {
  display: flex; flex-wrap: wrap;
  border: 4rpx solid #6b5b4e; border-radius: 12rpx; overflow: hidden;
  background: #6b5b4e;
}
.cell {
  display: flex; align-items: center; justify-content: center;
  line-height: 1; color: #b3a695; font-weight: 700;
  border: 1rpx solid rgba(107, 91, 78, 0.28); /* 数独式宫格细线 */
  box-sizing: border-box;
}
.cell.br { border-right: 5rpx solid #6b5b4e; }  /* 色块边界粗线 */
.cell.bb { border-bottom: 5rpx solid #6b5b4e; }
.cell.sysx { color: #d95f43; } /* 系统 X（判错锁定） */
.cell.conflict { box-shadow: inset 0 0 0 4rpx #e5533c; }
.rules-tip { font-size: 22rpx; color: #a08c76; margin-top: 20rpx; line-height: 1.8; }
